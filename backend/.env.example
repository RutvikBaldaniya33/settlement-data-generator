# Copy this file to backend/.env and fill in your own Razorpay TEST MODE
# keys. Never commit the real .env file — it's already covered by the
# repo's root .gitignore (the ".env" pattern there matches this path too).
#
# Get TEST mode keys from: Razorpay Dashboard -> Settings -> API Keys
# -> make sure "Test Mode" is toggled ON before generating them.
# Test key IDs always start with "rzp_test_". This project refuses to
# run against a "rzp_live_" key (see app/razorpay_client.py).

RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Optional — only one is needed, and only if you want the AI Finance
# Controller's free-text explanations to be LLM-phrased instead of the
# built-in offline template. Batch analysis, action requests, and all
# aggregate/count answers are always computed deterministically from the
# real batch regardless of whether any of these are set.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
